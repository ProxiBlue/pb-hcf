# Claude Code OTLP telemetry — env template
#
# Var names verified against https://code.claude.com/docs/en/monitoring-usage
# Check date: 2026-07-31
#
# Copy to a project's .ddev/claude-code/.claude/ (or wherever the project
# sources env for the `claude` CLI process) as otel.env, fill in
# <PROJECT_NAME>, and source it before running `claude`. See
# services/otel/README.md for the host-collector side of this pattern.
# Collector deployment itself is out of scope for pb-hcf 0.5.0.

# 1. Master switch — must be 1 to emit anything below.
CLAUDE_CODE_ENABLE_TELEMETRY=1

# 2. Exporters — comma-separated; set only what your backend consumes.
#    Options: otlp, prometheus, console, none
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# 3. OTLP endpoint — host-singleton collector (see services/otel/README.md).
#    Protocol options: grpc, http/protobuf, http/json
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317

# 4. Auth headers, only if the collector requires them (optional).
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>

# 5. Resource attributes — comma-separated key=value, NO spaces around
#    either "=" or ",". This is what lets one collector disambiguate
#    projects/users on shared dashboards (see services/otel/README.md).
#    Replace <PROJECT_NAME> with the ddev project slug (e.g. pvcpipesupplies).
OTEL_RESOURCE_ATTRIBUTES=project.name=<PROJECT_NAME>,user.name=<PROJECT_NAME>-claude
